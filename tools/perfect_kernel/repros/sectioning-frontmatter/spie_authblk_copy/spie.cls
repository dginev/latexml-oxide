% A minimal stand-in, written from scratch, for SPIE's 2015 spie.cls v3.4 (2406.08304's copy): it builds on article
% (:10 `\LoadClassWithOptions{article}`) and loads authblk (:31 `\RequirePackage{authblk}`), which the TeX Live v3.25
% copy does not.
\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{spie}[2015/08/14 v3.4 SPIE Proceedings class (stand-in)]
\LoadClassWithOptions{article}
\RequirePackage{authblk}

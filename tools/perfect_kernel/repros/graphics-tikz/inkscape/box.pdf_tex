\begingroup%
  \makeatletter%
  \ifx\svgwidth\undefined%
    \setlength{\unitlength}{56.9bp}%
  \else%
    \setlength{\unitlength}{\svgwidth}%
  \fi%
  \global\let\svgwidth\undefined%
  \makeatother%
  \begin{picture}(1,0.5)%
    \put(0,0){\includegraphics[width=\unitlength,page=1]{box.pdf}}%

% A stand-in written from scratch for the driver selection of gnuplot-lua-tikz.sty + gnuplot-lua-tikz-common.tex:17-32,
% :79-86 (rev. 114, author-shipped beside 2501.11366's plots; generated by gnuplot's lua terminal, no licence stated in
% the files): each pgf driver file names an output mode — `ps`, `pdf` or `html` —, an unknown driver is an error, and the
% raw-image macro is the mode's. The table's names, `\gnuplot@select@driver@<driver file>`, are the files' (the latexml
% driver adds its own, pgfsys_latexml_def.rs). No code of the files is copied.
\ProvidesPackage{gnuplot-lua-tikz-excerpt}
\RequirePackage{tikz}
\def\gpx@mode#1#2{\expandafter\def\csname gnuplot@select@driver@pgfsys-#1.def\endcsname{#2}}
\gpx@mode{dvi}{ps}\gpx@mode{dvips}{ps}\gpx@mode{textures}{ps}\gpx@mode{vtex}{ps}
\gpx@mode{dvipdfm}{pdf}\gpx@mode{dvipdfmx}{pdf}\gpx@mode{pdftex}{pdf}\gpx@mode{luatex}{pdf}\gpx@mode{xetex}{pdf}
\gpx@mode{tex4ht}{html}
\ifcsname gnuplot@select@driver@\pgfsysdriver\endcsname
  \edef\gnuplot@output@mode{\csname gnuplot@select@driver@\pgfsysdriver\endcsname}
\else
  \errmessage{The driver \pgfsysdriver\space is not supported by gnuplot-lua-tikz}%
\fi
\def\gp@rawimage@pdf#1#2#3#4#5#6{PDF}
\def\gp@rawimage@ps#1#2#3#4#5#6{PS}
\def\gp@rawimage@html#1#2#3#4#5#6{HTML}
\expandafter\let\expandafter\gp@rawimage\csname gp@rawimage@\gnuplot@output@mode\endcsname

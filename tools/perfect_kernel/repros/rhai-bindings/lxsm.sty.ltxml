package LaTeXML::Package::Pool;
use strict;
use warnings;
use LaTeXML::Package;
DefPrimitive('\opengrp', sub { $_[0]->bgroup; return; });
DefPrimitive('\closegrp', sub { $_[0]->egroup; return; });
DefPrimitive('\startpara', sub { $_[0]->enterHorizontal; return; });
DefPrimitive('\endpara', sub { $_[0]->leaveHorizontal; return; });
DefPrimitive('\opensg', sub { $_[0]->begingroup; return; });
DefPrimitive('\closesg', sub { $_[0]->endgroup; return; });
DefPrimitive('\openhm', sub { $_[0]->beginMode('restricted_horizontal'); return; });
DefPrimitive('\closehm', sub { $_[0]->endMode('restricted_horizontal'); return; });
DefConstructor('\withpost{}', "<ltx:text class='w'>#1</ltx:text>",
  afterDigest => sub { Digest('[after]'); });
DefPrimitive('\pafter', sub { return; }, afterDigest => sub { Digest('[pafter]'); });
DefPrimitive('\pbefore', sub { return; }, beforeDigest => sub { Digest('[pbefore]'); });
DefConstructor('\pm{}', "<ltx:text class='#cls'>#1</ltx:text>",
  properties => { cls => sub { 'c-' . ToString($_[1]); } });
1;

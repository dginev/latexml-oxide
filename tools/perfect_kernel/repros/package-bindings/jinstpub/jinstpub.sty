% MODIFIED: this is a modified and shortened copy of jinstpub.sty (2015/08/05 v.1.0 r763, as 2006.05543 ships it),
% made for latexml-oxide's repros (tools/perfect_kernel/repros/package-bindings/jinstpub/), not the original work:
% it keeps only the frontmatter stores (:60-150), a reduced title page (:172-252: the first-page header, the authors,
% affiliations, e-mails, abstract and keywords, the table of contents unless \notoc), the equation numbering (:335)
% and the caption (:362-378); the packages it loads are reduced to amsmath and hyperref.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{jinstpub}[2015/08/05 v.1.0 r763 (modified repro copy)]
\gdef\@fpheader{Prepared for submission to JINST}
\newif\ifnotoc\notocfalse
\RequirePackage{amsmath}
\RequirePackage{hyperref}
\def\@keywords{\@empty}
\def\@abstract{\@empty}
\newcommand{\keywords}[1]{\gdef\@keywords{#1}}
\renewcommand{\abstract}[1]{\gdef\@abstract{#1}}
\newcommand\note[2][]{\if!#1!\stepcounter{footnote}\footnotetext{#2}\else{\renewcommand\thefootnote{#1}\footnotetext{#2}}\fi}
\newcommand\jname{JINST}
\newcommand\notoc{\notoctrue}
\newtoks\auth@toks
\renewcommand{\author}[2][]{\if!#1!\auth@toks=\expandafter{\the\auth@toks#2\ }\else
  \auth@toks=\expandafter{\the\auth@toks#2$^{#1}$\ }\fi}
\newtoks\affil@toks\newif\ifaffil\affilfalse
\newcommand{\affiliation}[2][]{\affiltrue\if!#1!\affil@toks=\expandafter{\the\affil@toks{\item[]#2}}\else
  \affil@toks=\expandafter{\the\affil@toks{\item[$^{#1}$]#2}}\fi}
\newif\ifemailadd\emailaddfalse
\newtoks\email@toks\newcounter{email@counter}
\newcommand{\emailAdd}[1]{\emailaddtrue\ifnum\theemail@counter>0\email@toks=\expandafter{\the\email@toks, \@email{#1}}%
  \else\email@toks=\expandafter{\the\email@toks\@email{#1}}\fi\stepcounter{email@counter}}
\newcommand{\@email}[1]{\href{mailto:#1}{\ttfamily\small #1}}
\renewcommand\maketitle{\noindent{\small\scshape\@fpheader}\par
  {\LARGE\sffamily\bfseries\@title\par}%
  {\bfseries\sffamily\the\auth@toks\par}%
  \ifaffil\begin{list}{}{}\itshape\small\the\affil@toks\end{list}\fi
  \ifemailadd\noindent\textit{E-mail:} \the\email@toks\par\fi
  \if!\@abstract!\else\noindent\textsc{Abstract}:\ \@abstract\par\fi
  \if!\@keywords!\else\noindent\textsc{Keywords:} \@keywords\par\fi
  \ifnotoc\else\hrule\tableofcontents\hrule\fi
  \setcounter{footnote}{0}}
\numberwithin{equation}{section}
\def\fnum@figure{\textbf{\figurename\nobreakspace\thefigure}}
\long\def\@makecaption#1#2{\vskip\abovecaptionskip\small #1. #2\par\vskip\belowcaptionskip}

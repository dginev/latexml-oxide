\ProvidesPackage{bibhook}
% a class or package renewing the kernel's bibliography in its end-of-package hook (wiley2sp's w2sp-pss.clo:444 does
% it in \AtEndOfClass)
\AtEndOfPackage{\renewenvironment{thebibliography}[1]
     {\section*{\refname}\list{\@biblabel{\@arabic\c@enumiv}}{\usecounter{enumiv}}}{\endlist}}

              <XMTok font="italic" role="UNKNOWN" xml:id="p3.m2.1">g</XMTok>
              <XMTok role="VERTBAR" stretchy="false">|</XMTok>
            </XMWrap>
          </XMDual>
        </XMath>
      </Math> and <Math mode="inline" tex="\langle f|g\rangle" text="inner-product@(f, g)" xml:id="p3.m3">

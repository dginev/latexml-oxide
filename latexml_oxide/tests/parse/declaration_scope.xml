    <para xml:id="S4.p1">
      <p><Math mode="inline" tex="a*b" text="a * b" xml:id="S4.p1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="ADDOP">∗</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>

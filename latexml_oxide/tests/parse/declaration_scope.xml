    <para xml:id="S6.p1">
      <p><Math mode="inline" tex="p" text="p" xml:id="S6.p1.m1">
          <XMath>
            <XMTok font="italic" role="ID">p</XMTok>
          </XMath>
        </Math> before.</p>
    </para>
    <proof>
      <title class="ltx_runin" font="italic">Proof.</title>
      <para xml:id="S6.p2">
        <p>Inside <Math mode="inline" tex="p" text="p" xml:id="S6.p2.m1">
            <XMath>
              <XMTok font="italic" role="ID">p</XMTok>

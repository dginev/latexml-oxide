    <title><tag close=" ">2</tag>A declaration applies to its unit</title>
    <para xml:id="S2.p1">
      <p><Math mode="inline" tex="a" text="a" xml:id="S2.p1.m1">
          <XMath>
            <XMTok font="italic" role="ID">a</XMTok>
          </XMath>
        </Math></p>
      <equation xml:id="S2.E1">
        <tags>
          <tag>(1)</tag>
          <tag role="refnum">1</tag>
        </tags>
        <Math mode="display" tex="ab" text="a * b" xml:id="S2.E1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="ID">a</XMTok>
              <XMTok font="italic" role="ID">b</XMTok>
            </XMApp>
          </XMath>
        </Math>

<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p><Math mode="inline" tex="\operatorname{BC}(P,Q)=\int\sqrt{dP\,dQ}" text="BC@(P, Q) = integral@(square-root@(differential-d@(P) * differential-d@(Q)))" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMDual>
              <XMApp>
                <XMRef idref="p1.m1.1"/>
                <XMRef idref="p1.m1.2"/>
                <XMRef idref="p1.m1.3"/>
              </XMApp>
              <XMApp>
                <XMTok role="OPFUNCTION" scriptpos="post" xml:id="p1.m1.1">BC</XMTok>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="p1.m1.2">P</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="p1.m1.3">Q</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMApp>
            </XMDual>
            <XMApp>
              <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
              <XMApp>
                <XMTok meaning="square-root"/>
                <XMApp>
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMApp>
                    <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                    <XMTok font="italic" role="UNKNOWN" rpadding="1.7pt">P</XMTok>
                  </XMApp>
                  <XMApp>
                    <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                    <XMTok font="italic" role="UNKNOWN">Q</XMTok>
                  </XMApp>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\int\frac{dx}{2+x}" text="integral@(differential-d@(x) / (2 + x))" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
            <XMApp>
              <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
              <XMApp>
                <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">x</XMTok>
              </XMApp>
              <XMApp>
                <XMTok fontsize="70%" meaning="plus" role="ADDOP">+</XMTok>
                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">x</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\int e^{-dx}\,dx" text="integral@(e ^ (- d * x) * differential-d@(x))" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp rpadding="1.7pt">
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">e</XMTok>
                <XMApp>
                  <XMTok fontsize="70%" meaning="minus" role="ADDOP">-</XMTok>
                  <XMApp>
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">x</XMTok>
                  </XMApp>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="s=\sqrt{du+dv}" text="s = square-root@(d * u + d * v)" xml:id="p1.m4">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMTok font="italic" role="UNKNOWN">s</XMTok>
            <XMApp>
              <XMTok meaning="square-root"/>
              <XMApp>
                <XMTok meaning="plus" role="ADDOP">+</XMTok>
                <XMApp>
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">u</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">v</XMTok>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math></p>
  </para>
</document>

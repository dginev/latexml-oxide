<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <section inlist="toc" xml:id="S1">
    <tags>
      <tag>1</tag>
      <tag role="refnum">1</tag>
      <tag role="typerefnum">§1</tag>
    </tags>
    <title><tag close=" ">1</tag>An ellipsis among factors</title>
    <para xml:id="S1.p1">
      <p><Math mode="inline" tex="a_{1}a_{2}\cdots a_{n}" text="a _ 1 * a _ 2 * cdots * a _ n" xml:id="S1.p1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="p_{1}^{e_{1}}p_{2}^{e_{2}}\cdots p_{k}^{e_{k}}" text="(p _ 1) ^ (e _ 1) * (p _ 2) ^ (e _ 2) * cdots * (p _ k) ^ (e _ k)" xml:id="S1.p1.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">p</XMTok>
                  <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">e</XMTok>
                  <XMTok fontsize="50%" meaning="1" role="NUMBER">1</XMTok>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">p</XMTok>
                  <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">e</XMTok>
                  <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">p</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">e</XMTok>
                  <XMTok font="italic" fontsize="50%" role="UNKNOWN">k</XMTok>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="x_{i_{1}\cdots i_{k}}" text="x _ (i _ 1 * cdots * i _ k)" xml:id="S1.p1.m3">
          <XMath>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
                  <XMTok fontsize="50%" meaning="1" role="NUMBER">1</XMTok>
                </XMApp>
                <XMTok fontsize="70%" name="cdots" role="ELIDEOP">⋯</XMTok>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
                  <XMTok font="italic" fontsize="50%" role="UNKNOWN">k</XMTok>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="(1-x)(1-x^{2})\cdots(1-x^{n})" text="(1 - x) * (1 - x ^ 2) * cdots * (1 - x ^ n)" xml:id="S1.p1.m4">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMDual>
                <XMRef idref="S1.p1.m4.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="S1.p1.m4.1">
                    <XMTok meaning="minus" role="ADDOP">-</XMTok>
                    <XMTok meaning="1" role="NUMBER">1</XMTok>
                    <XMTok font="italic" role="UNKNOWN">x</XMTok>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
              <XMDual>
                <XMRef idref="S1.p1.m4.2"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="S1.p1.m4.2">
                    <XMTok meaning="minus" role="ADDOP">-</XMTok>
                    <XMTok meaning="1" role="NUMBER">1</XMTok>
                    <XMApp>
                      <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                      <XMTok font="italic" role="UNKNOWN">x</XMTok>
                      <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                    </XMApp>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMDual>
                <XMRef idref="S1.p1.m4.3"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="S1.p1.m4.3">
                    <XMTok meaning="minus" role="ADDOP">-</XMTok>
                    <XMTok meaning="1" role="NUMBER">1</XMTok>
                    <XMApp>
                      <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                      <XMTok font="italic" role="UNKNOWN">x</XMTok>
                      <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
                    </XMApp>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math>
<Math mode="inline" tex="\cdots x_{n}" text="cdots * x _ n" xml:id="S1.p1.m5">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="2^{n}\cdots" text="2 ^ n * cdots" xml:id="S1.p1.m6">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMTok meaning="2" role="NUMBER">2</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="B_{k}\cdots B_{1}" text="B _ k * cdots * B _ 1" xml:id="S1.p1.m7">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">B</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">B</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>
  <section inlist="toc" xml:id="S2">
    <tags>
      <tag>2</tag>
      <tag role="refnum">2</tag>
      <tag role="typerefnum">§2</tag>
    </tags>
    <title><tag close=" ">2</tag>An ellipsis as an operand</title>
    <para xml:id="S2.p1">
      <p><Math mode="inline" tex="a\times\cdots\times b" text="a * cdots * b" xml:id="S2.p1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">×</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="n\times\cdots\times n" text="n * cdots * n" xml:id="S2.p1.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">×</XMTok>
              <XMTok font="italic" role="UNKNOWN">n</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMTok font="italic" role="UNKNOWN">n</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a_{1}\cdot\cdots\cdot a_{n}" text="a _ 1 cdot cdots cdot a _ n" xml:id="S2.p1.m3">
          <XMath>
            <XMApp>
              <XMTok name="cdot" role="MULOP">⋅</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a_{1}\otimes\cdots\otimes a_{n}" text="a _ 1 tensor-product cdots tensor-product a _ n" xml:id="S2.p1.m4">
          <XMath>
            <XMApp>
              <XMTok meaning="tensor-product" name="otimes" role="MULOP">⊗</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="f\circ\cdots\circ g" text="f compose cdots compose g" xml:id="S2.p1.m5">
          <XMath>
            <XMApp>
              <XMTok meaning="compose" name="circ" role="MULOP">∘</XMTok>
              <XMTok font="italic" role="UNKNOWN">f</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMTok font="italic" role="UNKNOWN">g</XMTok>
            </XMApp>
          </XMath>
        </Math>
<Math mode="inline" tex="1\cdot 2\cdots n" text="(1 cdot 2) * cdots * n" xml:id="S2.p1.m6">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok name="cdot" role="MULOP">⋅</XMTok>
                <XMTok meaning="1" role="NUMBER">1</XMTok>
                <XMTok meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMTok font="italic" role="UNKNOWN">n</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a\cdot b\cdot\cdots" text="a cdot b cdot cdots" xml:id="S2.p1.m7">
          <XMath>
            <XMApp>
              <XMTok name="cdot" role="MULOP">⋅</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>
  <section inlist="toc" xml:id="S3">
    <tags>
      <tag>3</tag>
      <tag role="refnum">3</tag>
      <tag role="typerefnum">§3</tag>
    </tags>
    <title><tag close=" ">3</tag>Controls</title>
    <para xml:id="S3.p1">
      <p><Math mode="inline" tex="a\cdot b\cdots" text="a cdot b cdot cdots" xml:id="S3.p1.m1">
          <XMath>
            <XMApp>
              <XMTok name="cdot" role="MULOP">⋅</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="b_{1}+b_{2}\cdots+b_{j}" text="b _ 1 + b _ 2 + cdots + b _ j" xml:id="S3.p1.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">b</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">b</XMTok>
                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">b</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">j</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="x_{1}+\cdots+x_{n}" text="x _ 1 + cdots + x _ n" xml:id="S3.p1.m3">
          <XMath>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="A\cup\cdots\cup B" text="A union cdots union B" xml:id="S3.p1.m4">
          <XMath>
            <XMApp>
              <XMTok meaning="union" name="cup" role="ADDOP">∪</XMTok>
              <XMTok font="italic" role="UNKNOWN">A</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMTok font="italic" role="UNKNOWN">B</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="x_{1}\leq\cdots\leq x_{n}" text="x _ 1 &lt;= cdots &lt;= x _ n" xml:id="S3.p1.m5">
          <XMath>
            <XMApp>
              <XMTok meaning="multirelation"/>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
              <XMTok meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
              <XMTok name="cdots" role="ELIDEOP">⋯</XMTok>
              <XMTok meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
  </section>

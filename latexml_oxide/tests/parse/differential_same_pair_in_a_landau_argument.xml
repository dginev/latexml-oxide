  <para xml:id="p1">
    <p><Math mode="inline" tex="\mathcal{L}(\phi,\phi+d\phi)=\frac{1}{2}\rho^{\prime\prime}(0)\Big((d\psi)^{2}+(d\theta)^{2}\Big)+o\!\left(\|d\phi\|^{2}\right)" text="L@(vector@(phi, phi + differential-d@(phi))) = (1 / 2) * rho ^ prime2 * 0 * ((differential-d@(psi)) ^ 2 + (differential-d@(theta)) ^ 2) + o@((norm@(differential-d@(phi))) ^ 2)" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok font="caligraphic" role="UNKNOWN">L</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="vector"/>
                  <XMRef idref="p1.m1.1"/>
                  <XMRef idref="p1.m1.2"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" name="phi" role="UNKNOWN" xml:id="p1.m1.1">ϕ</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMApp xml:id="p1.m1.2">
                    <XMTok meaning="plus" role="ADDOP">+</XMTok>
                    <XMTok font="italic" name="phi" role="UNKNOWN">ϕ</XMTok>
                    <XMApp>
                      <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMTok font="italic" name="phi" role="UNKNOWN">ϕ</XMTok>
                    </XMApp>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMApp>
                  <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                  <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                  <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" name="rho" role="UNKNOWN">ρ</XMTok>
                  <XMTok fontsize="70%" name="prime2" role="SUPOP">′′</XMTok>
                </XMApp>
                <XMDual>
                  <XMRef idref="p1.m1.3"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">(</XMTok>
                    <XMTok meaning="0" role="NUMBER" xml:id="p1.m1.3">0</XMTok>
                    <XMTok role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
                <XMDual>
                  <XMRef idref="p1.m1.4"/>
                  <XMWrap>
                    <XMTok fontsize="160%" role="OPEN" stretchy="false">(</XMTok>
                    <XMApp xml:id="p1.m1.4">
                      <XMTok meaning="plus" role="ADDOP">+</XMTok>
                      <XMApp>
                        <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                        <XMDual>
                          <XMRef idref="p1.m1.5"/>
                          <XMWrap>
                            <XMTok role="OPEN" stretchy="false">(</XMTok>
                            <XMApp xml:id="p1.m1.5">
                              <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                              <XMTok font="italic" name="psi" role="UNKNOWN">ψ</XMTok>
                            </XMApp>
                            <XMTok role="CLOSE" stretchy="false">)</XMTok>
                          </XMWrap>
                        </XMDual>
                        <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                      </XMApp>
                      <XMApp>
                        <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                        <XMDual>
                          <XMRef idref="p1.m1.6"/>
                          <XMWrap>
                            <XMTok role="OPEN" stretchy="false">(</XMTok>
                            <XMApp xml:id="p1.m1.6">
                              <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                              <XMTok font="italic" name="theta" role="UNKNOWN">θ</XMTok>
                            </XMApp>
                            <XMTok role="CLOSE" stretchy="false">)</XMTok>
                          </XMWrap>
                        </XMDual>
                        <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                      </XMApp>
                    </XMApp>
                    <XMTok fontsize="160%" role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMApp>
                <XMTok font="italic" role="UNKNOWN" rpadding="-1.7pt">o</XMTok>
                <XMDual>
                  <XMRef idref="p1.m1.7"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="true">(</XMTok>
                    <XMApp xml:id="p1.m1.7">
                      <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                      <XMDual>
                        <XMApp>
                          <XMTok meaning="norm"/>
                          <XMRef idref="p1.m1.8"/>
                        </XMApp>
                        <XMWrap>
                          <XMTok name="||" role="OPEN">‖</XMTok>
                          <XMApp xml:id="p1.m1.8">
                            <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                            <XMTok font="italic" name="phi" role="UNKNOWN">ϕ</XMTok>
                          </XMApp>
                          <XMTok name="||" role="CLOSE">‖</XMTok>
                        </XMWrap>
                      </XMDual>
                      <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="true">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="T=O(dk^{3})" text="T = O@(d * k ^ 3)" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMTok font="italic" role="UNKNOWN">T</XMTok>

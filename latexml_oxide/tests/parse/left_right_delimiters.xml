      <tag role="typerefnum">§1</tag>
    </tags>
    <title><tag close=" ">1</tag>A delimiter outside the map</title>
    <para xml:id="S1.p1">
      <p><Math mode="inline" tex="\left\llbracket x\right\rrbracket" text="delimited-⟦⟧@(x)" xml:id="S1.p1.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="delimited-⟦⟧"/>
                <XMRef idref="S1.p1.m1.1"/>
              </XMApp>
              <XMWrap>
                <XMTok name="llbracket" role="OPEN" stretchy="true">⟦</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="S1.p1.m1.1">x</XMTok>
                <XMTok name="rrbracket" role="CLOSE" stretchy="true">⟧</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math></p>
    </para>
  </section>

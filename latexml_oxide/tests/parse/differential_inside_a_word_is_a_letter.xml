<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p><Math mode="inline" tex="dX_{t}=a\,dt+b\,dW_{t}" text="differential-d@(X _ t) = a * differential-d@(t) + b * differential-d@(W _ t)" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">X</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN" rpadding="1.7pt">a</XMTok>
                <XMApp>
                  <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">t</XMTok>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN" rpadding="1.7pt">b</XMTok>
                <XMApp>
                  <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">W</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
                  </XMApp>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="MidX,OldY" text="list@(M * i * d * X, O * l * d * Y)" xml:id="p1.m2">
        <XMath>
          <XMDual>
            <XMApp>
              <XMTok meaning="list"/>
              <XMRef idref="p1.m2.1"/>
              <XMRef idref="p1.m2.2"/>
            </XMApp>
            <XMWrap>
              <XMApp xml:id="p1.m2.1">
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">M</XMTok>
                <XMTok font="italic" role="UNKNOWN">i</XMTok>
                <XMTok font="italic" role="UNKNOWN">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">X</XMTok>
              </XMApp>
              <XMTok role="PUNCT">,</XMTok>
              <XMApp xml:id="p1.m2.2">
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">O</XMTok>
                <XMTok font="italic" role="UNKNOWN">l</XMTok>
                <XMTok font="italic" role="UNKNOWN">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">Y</XMTok>
              </XMApp>
            </XMWrap>
          </XMDual>
        </XMath>
      </Math>
<Math mode="inline" tex="R(node)\leftarrow D(node)+1" text="R@(n * o * d * e) leftarrow D@(n * o * d * e) + 1" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMTok name="leftarrow" role="ARROW">←</XMTok>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">R</XMTok>
              <XMDual>
                <XMRef idref="p1.m3.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="p1.m3.1">
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" role="UNKNOWN">n</XMTok>
                    <XMTok font="italic" role="UNKNOWN">o</XMTok>
                    <XMTok font="italic" role="UNKNOWN">d</XMTok>
                    <XMTok font="italic" role="UNKNOWN">e</XMTok>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMApp>
                <XMTok font="italic" role="UNKNOWN">D</XMTok>
                <XMDual>
                  <XMRef idref="p1.m3.2"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">(</XMTok>
                    <XMApp xml:id="p1.m3.2">
                      <XMTok meaning="times" role="MULOP">⁢</XMTok>
                      <XMTok font="italic" role="UNKNOWN">n</XMTok>
                      <XMTok font="italic" role="UNKNOWN">o</XMTok>
                      <XMTok font="italic" role="UNKNOWN">d</XMTok>
                      <XMTok font="italic" role="UNKNOWN">e</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMTok meaning="1" role="NUMBER">1</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="PruningMode" text="P * r * u * n * i * n * g * M * o * d * e" xml:id="p1.m4">
        <XMath>
          <XMApp>
            <XMTok meaning="times" role="MULOP">⁢</XMTok>
            <XMTok font="italic" role="UNKNOWN">P</XMTok>
            <XMTok font="italic" role="UNKNOWN">r</XMTok>
            <XMTok font="italic" role="UNKNOWN">u</XMTok>
            <XMTok font="italic" role="UNKNOWN">n</XMTok>
            <XMTok font="italic" role="UNKNOWN">i</XMTok>
            <XMTok font="italic" role="UNKNOWN">n</XMTok>
            <XMTok font="italic" role="UNKNOWN">g</XMTok>
            <XMTok font="italic" role="UNKNOWN">M</XMTok>
            <XMTok font="italic" role="UNKNOWN">o</XMTok>
            <XMTok font="italic" role="UNKNOWN">d</XMTok>
            <XMTok font="italic" role="UNKNOWN">e</XMTok>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="TdS-pdV+\mu dM" text="(T * differential-d@(S) - p * differential-d@(V)) + mu * differential-d@(M)" xml:id="p1.m5">
        <XMath>
          <XMApp>
            <XMTok meaning="plus" role="ADDOP">+</XMTok>
            <XMApp>
              <XMTok meaning="minus" role="ADDOP">-</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">T</XMTok>
                <XMApp>
                  <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">S</XMTok>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">p</XMTok>
                <XMApp>
                  <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">V</XMTok>
                </XMApp>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" name="mu" role="UNKNOWN">μ</XMTok>
              <XMApp>
                <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">M</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="qKdS_{3}" text="q * K * d * S _ 3" xml:id="p1.m6">
        <XMath>
          <XMApp>
            <XMTok meaning="times" role="MULOP">⁢</XMTok>
            <XMTok font="italic" role="UNKNOWN">q</XMTok>
            <XMTok font="italic" role="UNKNOWN">K</XMTok>
            <XMTok font="italic" role="UNKNOWN">d</XMTok>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
              <XMTok font="italic" role="UNKNOWN">S</XMTok>
              <XMTok fontsize="70%" meaning="3" role="NUMBER">3</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="dxdy" text="differential-d@(x) * differential-d@(y)" xml:id="p1.m7">
        <XMath>
          <XMApp>
            <XMTok meaning="times" role="MULOP">⁢</XMTok>
            <XMApp>
              <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
            </XMApp>
            <XMApp>
              <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" role="UNKNOWN">y</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\mathrm{d}\mathbf{x}\mathrm{d}t" text="differential-d@(x) * differential-d@(t)" xml:id="p1.m8">
        <XMath>
          <XMApp>
            <XMTok meaning="times" role="MULOP">⁢</XMTok>
            <XMApp>
              <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="bold" role="UNKNOWN">x</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" role="UNKNOWN">t</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="dX_{t}" text="differential-d@(X _ t)" xml:id="p1.m9">
        <XMath>
          <XMApp>
            <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
              <XMTok font="italic" role="UNKNOWN">X</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="dF(z)=-c\int_{0}^{R}\rho\,d\rho" text="differential-d@(F@(z)) = - c * ((integral _ 0) ^ R)@(rho * differential-d@(rho))" xml:id="p1.m10">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMApp>
                <XMTok font="italic" role="UNKNOWN">F</XMTok>
                <XMDual>
                  <XMRef idref="p1.m10.1"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">(</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="p1.m10.1">z</XMTok>
                    <XMTok role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok meaning="minus" role="ADDOP">-</XMTok>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMTok font="italic" role="UNKNOWN">c</XMTok>
                <XMApp>
                  <XMApp>
                    <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                    <XMApp>
                      <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                      <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
                      <XMTok fontsize="70%" meaning="0" role="NUMBER">0</XMTok>
                    </XMApp>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">R</XMTok>
                  </XMApp>
                  <XMApp>
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" name="rho" role="UNKNOWN" rpadding="1.7pt">ρ</XMTok>
                    <XMApp>
                      <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMTok font="italic" name="rho" role="UNKNOWN">ρ</XMTok>
                    </XMApp>
                  </XMApp>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="dF(z)" text="differential-d@(F@(z))" xml:id="p1.m11">
        <XMath>
          <XMApp>
            <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">F</XMTok>
              <XMDual>
                <XMRef idref="p1.m11.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="p1.m11.1">z</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\mathrm{d}s^{2}=\frac{\mathrm{d}t}{g^{2}}\|\mathrm{d}f\|^{2}" text="(differential-d@(s)) ^ 2 = (differential-d@(t) / g ^ 2) * (norm@(differential-d@(f))) ^ 2" xml:id="p1.m12">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">s</XMTok>
              </XMApp>
              <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                <XMApp>
                  <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">g</XMTok>
                  <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="norm"/>
                    <XMRef idref="p1.m12.1"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok name="||" role="OPEN">‖</XMTok>
                    <XMApp xml:id="p1.m12.1">
                      <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMTok font="italic" role="UNKNOWN">f</XMTok>
                    </XMApp>
                    <XMTok name="||" role="CLOSE">‖</XMTok>
                  </XMWrap>
                </XMDual>
                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\mathrm{d}f" text="differential-d@(f)" xml:id="p1.m13">
        <XMath>
          <XMApp>
            <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
            <XMTok font="italic" role="UNKNOWN">f</XMTok>
          </XMApp>
        </XMath>
      </Math></p>
  </para>
</document>

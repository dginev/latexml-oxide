    <title><tag close=" ">3</tag>An arrow operand in parentheses parses</title>
    <para xml:id="S3.p1">
      <p><Math mode="inline" tex="a=\mathrm{prob}(\rightarrow j)" text="a = annotated@(prob, absent rightarrow j)" xml:id="S3.p1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMApp>
                <XMTok meaning="annotated"/>
                <XMTok role="UNKNOWN">prob</XMTok>
                <XMDual>
                  <XMRef idref="S3.p1.m1.1"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">(</XMTok>
                    <XMApp xml:id="S3.p1.m1.1">
                      <XMTok name="rightarrow" role="ARROW">→</XMTok>
                      <XMTok meaning="absent"/>
                      <XMTok font="italic" role="UNKNOWN">j</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a=f(\rightarrow j)" text="a = annotated@(f, absent rightarrow j)" xml:id="S3.p1.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMApp>
                <XMTok meaning="annotated"/>
                <XMTok font="italic" role="UNKNOWN">f</XMTok>
                <XMDual>
                  <XMRef idref="S3.p1.m2.1"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">(</XMTok>
                    <XMApp xml:id="S3.p1.m2.1">
                      <XMTok name="rightarrow" role="ARROW">→</XMTok>
                      <XMTok meaning="absent"/>
                      <XMTok font="italic" role="UNKNOWN">j</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMApp>

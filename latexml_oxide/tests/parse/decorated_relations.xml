                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
              <XMTok font="italic" role="UNKNOWN">y</XMTok>
            </XMApp>
          </XMath>
        </Math>
<Math mode="inline" tex="x,y\leq_{k}z" text="formulae@(x &lt;= _ k z, y &lt;= _ k z)" xml:id="S1.p1.m7">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="formulae"/>
                <XMApp>
                  <XMRef idref="S1.p1.m7.1"/>
                  <XMRef idref="S1.p1.m7.2"/>
                  <XMRef idref="S1.p1.m7.4"/>
                </XMApp>
                <XMApp>
                  <XMRef idref="S1.p1.m7.1"/>
                  <XMRef idref="S1.p1.m7.3"/>
                  <XMRef idref="S1.p1.m7.4"/>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMApp role="RELOP" xml:id="S1.p1.m7.1">
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
                </XMApp>
                <XMWrap>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S1.p1.m7.2">x</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S1.p1.m7.3">y</XMTok>
                </XMWrap>
                <XMTok font="italic" role="UNKNOWN" xml:id="S1.p1.m7.4">z</XMTok>
              </XMApp>
            </XMDual>
          </XMath>
        </Math> <Math mode="inline" tex="a=_{k}b=" text="a = _ k b = absent" xml:id="S1.p1.m8">
          <XMath>
            <XMApp>
              <XMTok meaning="multirelation"/>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMApp role="RELOP">
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok meaning="equals" role="RELOP">=</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMTok meaning="absent"/>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a&lt;b&lt;c" text="a &lt; b &lt; c" xml:id="S1.p1.m9">
          <XMath>
            <XMApp>
              <XMTok meaning="multirelation"/>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok meaning="less-than" role="RELOP">&lt;</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
              <XMTok meaning="less-than" role="RELOP">&lt;</XMTok>
              <XMTok font="italic" role="UNKNOWN">c</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a&lt;=b&lt;=c" text="a &lt;= b &lt;= c" xml:id="S1.p1.m10">
          <XMath>
            <XMApp>
              <XMTok meaning="multirelation"/>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok meaning="less-than-or-equals" role="RELOP">&lt;=</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
              <XMTok meaning="less-than-or-equals" role="RELOP">&lt;=</XMTok>
              <XMTok font="italic" role="UNKNOWN">c</XMTok>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a&gt;&gt;b&gt;&gt;c" text="a &gt;&gt; b &gt;&gt; c" xml:id="S1.p1.m11">
          <XMath>
            <XMApp>
              <XMTok meaning="multirelation"/>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok meaning="much-greater-than" role="RELOP">&gt;&gt;</XMTok>
              <XMTok font="italic" role="UNKNOWN">b</XMTok>
              <XMTok meaning="much-greater-than" role="RELOP">&gt;&gt;</XMTok>
              <XMTok font="italic" role="UNKNOWN">c</XMTok>
            </XMApp>
          </XMath>
        </Math>
<Math mode="inline" tex="\sum_{i}a_{i}\otimes_{k}b_{i}" text="(sum _ i)@(a _ i tensor-product _ k b _ i)" xml:id="S1.p1.m12">
          <XMath>
            <XMApp>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok mathstyle="text" meaning="sum" role="SUMOP" scriptpos="post">∑</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
              </XMApp>
              <XMApp>
                <XMApp role="MULOP">
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok meaning="tensor-product" name="otimes" role="MULOP">⊗</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">a</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">b</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="\int f\otimes_{k}g" text="integral@(f tensor-product _ k g)" xml:id="S1.p1.m13">
          <XMath>
            <XMApp>
              <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
              <XMApp>
                <XMApp role="MULOP">
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>

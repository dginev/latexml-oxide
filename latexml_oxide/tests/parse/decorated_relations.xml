              </XMApp>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a\otimes_{k}DB" text="a tensor-product _ k (D * B)" xml:id="S1.p1.m14">
          <XMath>
            <XMApp>
              <XMApp role="MULOP">

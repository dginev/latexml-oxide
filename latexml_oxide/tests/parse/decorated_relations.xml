    <title><tag close=" ">2</tag>A sequent’s list keeps the relation outside</title>
    <para xml:id="S2.p1">
      <p><Math mode="inline" tex="a_{1},b_{2}\vdash c,d" text="formulae@(a _ 1 proves list@(c, d), b _ 2 proves list@(c, d))" xml:id="S2.p1.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="formulae"/>
                <XMApp>
                  <XMRef idref="S2.p1.m1.1"/>
                  <XMRef idref="S2.p1.m1.2"/>
                  <XMRef idref="S2.p1.m1.4"/>
                </XMApp>
                <XMApp>
                  <XMRef idref="S2.p1.m1.1"/>
                  <XMRef idref="S2.p1.m1.3"/>
                  <XMRef idref="S2.p1.m1.4"/>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="proves" name="vdash" role="METARELOP" xml:id="S2.p1.m1.1">⊢</XMTok>
                <XMWrap>
                  <XMApp xml:id="S2.p1.m1.2">
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">a</XMTok>
                    <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                  </XMApp>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMApp xml:id="S2.p1.m1.3">
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">b</XMTok>
                    <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                  </XMApp>
                </XMWrap>
                <XMDual xml:id="S2.p1.m1.4">
                  <XMApp>
                    <XMTok meaning="list"/>
                    <XMRef idref="S2.p1.m1.5"/>
                    <XMRef idref="S2.p1.m1.6"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m1.5">c</XMTok>
                    <XMTok role="PUNCT">,</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m1.6">d</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMDual>
          </XMath>
        </Math> <Math mode="inline" tex="S_{1},S_{2}\vdash A,B,C" text="formulae@(S _ 1 proves list@(A, B, C), S _ 2 proves list@(A, B, C))" xml:id="S2.p1.m2">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="formulae"/>
                <XMApp>
                  <XMRef idref="S2.p1.m2.1"/>
                  <XMRef idref="S2.p1.m2.2"/>
                  <XMRef idref="S2.p1.m2.4"/>
                </XMApp>
                <XMApp>
                  <XMRef idref="S2.p1.m2.1"/>
                  <XMRef idref="S2.p1.m2.3"/>
                  <XMRef idref="S2.p1.m2.4"/>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="proves" name="vdash" role="METARELOP" xml:id="S2.p1.m2.1">⊢</XMTok>
                <XMWrap>
                  <XMApp xml:id="S2.p1.m2.2">
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">S</XMTok>
                    <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                  </XMApp>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMApp xml:id="S2.p1.m2.3">
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">S</XMTok>
                    <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                  </XMApp>
                </XMWrap>
                <XMDual xml:id="S2.p1.m2.4">
                  <XMApp>
                    <XMTok meaning="list"/>
                    <XMRef idref="S2.p1.m2.5"/>
                    <XMRef idref="S2.p1.m2.6"/>
                    <XMRef idref="S2.p1.m2.7"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m2.5">A</XMTok>
                    <XMTok role="PUNCT">,</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m2.6">B</XMTok>
                    <XMTok role="PUNCT">,</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m2.7">C</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMDual>
          </XMath>
        </Math> <Math mode="inline" tex="a_{1},b_{2}\leq c" text="formulae@(a _ 1 &lt;= c, b _ 2 &lt;= c)" xml:id="S2.p1.m3">

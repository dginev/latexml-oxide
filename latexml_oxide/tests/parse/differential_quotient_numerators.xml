  <para xml:id="p1">
    <p><Math mode="inline" tex="\frac{d(uv)}{dz}" text="d@(u * v) / differential-d@(z)" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMDual>
                <XMRef idref="p1.m1.1"/>
                <XMWrap>
                  <XMTok fontsize="70%" role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="p1.m1.1">
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">u</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">v</XMTok>
                  </XMApp>
                  <XMTok fontsize="70%" role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">z</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\frac{d\left(q^{2}\right)}{dq}" text="d@(q ^ 2) / differential-d@(q)" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMDual>
                <XMRef idref="p1.m2.1"/>
                <XMWrap>
                  <XMTok fontsize="70%" role="OPEN" stretchy="true">(</XMTok>
                  <XMApp xml:id="p1.m2.1">
                    <XMTok role="SUPERSCRIPTOP" scriptpos="post3"/>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">q</XMTok>
                    <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
                  </XMApp>
                  <XMTok fontsize="70%" role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">q</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\frac{d\vec{r}}{d\tau}" text="(d * vec@(r)) / differential-d@(tau)" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMApp>
                <XMTok fontsize="70%" name="vec" role="OVERACCENT" stretchy="false">→</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">r</XMTok>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" name="tau" role="UNKNOWN">τ</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\frac{d^{2}\vec{R}}{dn^{2}}" text="(d ^ 2 * vec@(R)) / (differential-d@(n)) ^ 2" xml:id="p1.m4">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
                <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
              <XMApp>
                <XMTok fontsize="70%" name="vec" role="OVERACCENT" stretchy="false">→</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">R</XMTok>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
              <XMApp>
                <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
              </XMApp>
              <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\frac{d\langle A\rangle}{dw}" text="(d * delimited-⟨⟩@(A)) / differential-d@(w)" xml:id="p1.m5">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="delimited-⟨⟩"/>
                  <XMRef idref="p1.m5.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok fontsize="70%" name="langle" role="OPEN" stretchy="false">⟨</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN" xml:id="p1.m5.1">A</XMTok>
                  <XMTok fontsize="70%" name="rangle" role="CLOSE" stretchy="false">⟩</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">w</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\frac{d|\psi\rangle}{dh}" text="(d * ket@(psi)) / differential-d@(h)" xml:id="p1.m6">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="ket"/>
                  <XMRef idref="p1.m6.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok fontsize="70%" role="VERTBAR" stretchy="false">|</XMTok>
                  <XMTok font="italic" fontsize="70%" name="psi" role="UNKNOWN" xml:id="p1.m6.1">ψ</XMTok>
                  <XMTok fontsize="70%" name="rangle" role="CLOSE" stretchy="false">⟩</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">h</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\frac{d\ln Z}{d\beta}" text="(d * natural-logarithm@(Z)) / differential-d@(beta)" xml:id="p1.m7">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMApp>
                <XMTok fontsize="70%" meaning="natural-logarithm" role="OPFUNCTION">ln</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">Z</XMTok>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" name="beta" role="UNKNOWN">β</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\frac{d\sin\phi}{d\phi}" text="(d * sine@(phi)) / differential-d@(phi)" xml:id="p1.m8">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMApp>
                <XMTok fontsize="70%" meaning="sine" role="TRIGFUNCTION">sin</XMTok>
                <XMTok font="italic" fontsize="70%" name="phi" role="UNKNOWN">ϕ</XMTok>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" fontsize="70%" name="phi" role="UNKNOWN">ϕ</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math></p>
  </para>

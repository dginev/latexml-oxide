<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p><Math mode="inline" tex="J(E)=\int_{a}^{E}\frac{\sigma(E^{\prime})}{\left(dE^{\prime}/dx\right)}\,dE^{\prime}" text="J@(E) = ((integral _ a) ^ E)@((sigma@(E ^ prime) / differential-d@(E ^ prime) / differential-d@(x)) * differential-d@(E ^ prime))" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">J</XMTok>
              <XMDual>
                <XMRef idref="p1.m1.1"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="p1.m1.1">E</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
            <XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                  <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">a</XMTok>
                </XMApp>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">E</XMTok>
              </XMApp>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMApp rpadding="1.7pt">
                  <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                  <XMApp>
                    <XMTok font="italic" fontsize="70%" name="sigma" role="UNKNOWN">σ</XMTok>
                    <XMDual>
                      <XMRef idref="p1.m1.2"/>
                      <XMWrap>
                        <XMTok fontsize="70%" role="OPEN" stretchy="false">(</XMTok>
                        <XMApp xml:id="p1.m1.2">
                          <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                          <XMTok font="italic" fontsize="70%" role="UNKNOWN">E</XMTok>
                          <XMTok fontsize="50%" name="prime" role="SUPOP">′</XMTok>
                        </XMApp>
                        <XMTok fontsize="70%" role="CLOSE" stretchy="false">)</XMTok>
                      </XMWrap>
                    </XMDual>
                  </XMApp>
                  <XMDual>
                    <XMRef idref="p1.m1.3"/>
                    <XMWrap>
                      <XMTok fontsize="70%" role="OPEN" stretchy="true">(</XMTok>
                      <XMApp xml:id="p1.m1.3">
                        <XMTok fontsize="70%" meaning="divide" role="MULOP">/</XMTok>
                        <XMApp>
                          <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                          <XMApp>
                            <XMTok role="SUPERSCRIPTOP" scriptpos="post3"/>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN">E</XMTok>
                            <XMTok fontsize="50%" name="prime" role="SUPOP">′</XMTok>
                          </XMApp>
                        </XMApp>
                        <XMApp>
                          <XMTok font="italic" fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                          <XMTok font="italic" fontsize="70%" role="UNKNOWN">x</XMTok>
                        </XMApp>
                      </XMApp>
                      <XMTok fontsize="70%" role="CLOSE" stretchy="true">)</XMTok>
                    </XMWrap>
                  </XMDual>
                </XMApp>
                <XMApp>
                  <XMTok font="italic" meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMApp>
                    <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">E</XMTok>
                    <XMTok fontsize="70%" name="prime" role="SUPOP">′</XMTok>
                  </XMApp>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\frac{1}{\mathrm{d}s/\mathrm{d}\lambda}" text="1 / differential-d@(s) / differential-d@(lambda)" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
            <XMApp>
              <XMTok fontsize="70%" meaning="divide" role="MULOP">/</XMTok>
              <XMApp>
                <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">s</XMTok>
              </XMApp>
              <XMApp>
                <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" fontsize="70%" name="lambda" role="UNKNOWN">λ</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\int_{0}^{t}g\underbrace{\Phi(t,s)}_{=\mathrm{d}h(s)/\mathrm{d}s}\mathrm{d}s" text="((integral _ 0) ^ t)@(g * (underbrace@(Phi@(vector@(t, s)))) _ (absent = differential-d@(h@(s)) / differential-d@(s)) * differential-d@(s))" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
                <XMTok fontsize="70%" meaning="0" role="NUMBER">0</XMTok>
              </XMApp>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">g</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="mid1"/>
                <XMApp scriptpos="mid">
                  <XMTok name="underbrace" role="UNDERACCENT" stretchy="true">⏟</XMTok>
                  <XMApp>
                    <XMTok name="Phi" role="UNKNOWN">Φ</XMTok>
                    <XMDual>
                      <XMApp>
                        <XMTok meaning="vector"/>
                        <XMRef idref="p1.m3.1"/>
                        <XMRef idref="p1.m3.2"/>
                      </XMApp>
                      <XMWrap>
                        <XMTok role="OPEN" stretchy="false">(</XMTok>
                        <XMTok font="italic" role="UNKNOWN" xml:id="p1.m3.1">t</XMTok>
                        <XMTok role="PUNCT">,</XMTok>
                        <XMTok font="italic" role="UNKNOWN" xml:id="p1.m3.2">s</XMTok>
                        <XMTok role="CLOSE" stretchy="false">)</XMTok>
                      </XMWrap>
                    </XMDual>
                  </XMApp>
                </XMApp>
                <XMApp>
                  <XMTok fontsize="70%" meaning="equals" role="RELOP">=</XMTok>
                  <XMTok meaning="absent"/>
                  <XMApp>
                    <XMTok fontsize="70%" meaning="divide" role="MULOP">/</XMTok>
                    <XMApp>
                      <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMApp>
                        <XMTok font="italic" fontsize="70%" role="UNKNOWN">h</XMTok>
                        <XMDual>
                          <XMRef idref="p1.m3.3"/>
                          <XMWrap>
                            <XMTok fontsize="70%" role="OPEN" stretchy="false">(</XMTok>
                            <XMTok font="italic" fontsize="70%" role="UNKNOWN" xml:id="p1.m3.3">s</XMTok>
                            <XMTok fontsize="70%" role="CLOSE" stretchy="false">)</XMTok>
                          </XMWrap>
                        </XMDual>
                      </XMApp>
                    </XMApp>
                    <XMApp>
                      <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMTok font="italic" fontsize="70%" role="UNKNOWN">s</XMTok>
                    </XMApp>
                  </XMApp>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">s</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\frac{3}{2\,\mathrm{d}t}" text="3 / (2 * d * t)" xml:id="p1.m4">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMTok fontsize="70%" meaning="3" role="NUMBER">3</XMTok>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok fontsize="70%" meaning="2" role="NUMBER" rpadding="1.7pt">2</XMTok>
              <XMTok fontsize="70%" role="UNKNOWN">d</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math></p>
  </para>
</document>

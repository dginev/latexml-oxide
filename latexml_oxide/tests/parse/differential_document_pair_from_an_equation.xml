<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p><Math mode="inline" tex="\mathrm{d}s^{2}=\frac{\mathrm{d}t}{g^{2}}\|\mathrm{d}f\|^{2}" text="(differential-d@(s)) ^ 2 = ((d * t) / g ^ 2) * (norm@(differential-d@(f))) ^ 2" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">s</XMTok>
              </XMApp>
              <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                <XMApp>
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok fontsize="70%" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">g</XMTok>
                  <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="norm"/>
                    <XMRef idref="p1.m1.1"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok name="||" role="OPEN">‖</XMTok>
                    <XMApp xml:id="p1.m1.1">
                      <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMTok font="italic" role="UNKNOWN">f</XMTok>
                    </XMApp>
                    <XMTok name="||" role="CLOSE">‖</XMTok>
                  </XMWrap>
                </XMDual>
                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\mathrm{d}g=\dot{g}\,\mathrm{d}t" text="differential-d@(g) = dot@(g) * differential-d@(t)" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" role="UNKNOWN">g</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp rpadding="1.7pt">
                <XMTok name="dot" role="OVERACCENT">˙</XMTok>
                <XMTok font="italic" role="UNKNOWN">g</XMTok>
              </XMApp>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">t</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\mathrm{d}f" text="differential-d@(f)" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
            <XMTok font="italic" role="UNKNOWN">f</XMTok>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="V_{g}=\frac{2D}{g^{2}}(\mathrm{d}g)^{2}" text="V _ g = ((2 * D) / g ^ 2) * (differential-d@(g)) ^ 2" xml:id="p1.m4">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
              <XMTok font="italic" role="UNKNOWN">V</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">g</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                <XMApp>
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">D</XMTok>
                </XMApp>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                  <XMTok font="italic" fontsize="70%" role="UNKNOWN">g</XMTok>
                  <XMTok fontsize="50%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMDual>
                  <XMRef idref="p1.m4.1"/>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">(</XMTok>
                    <XMApp xml:id="p1.m4.1">
                      <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                      <XMTok font="italic" role="UNKNOWN">g</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="false">)</XMTok>
                  </XMWrap>
                </XMDual>
                <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\sqrt{\mathrm{d}t}" text="square-root@(d * t)" xml:id="p1.m5">
        <XMath>
          <XMApp>
            <XMTok meaning="square-root"/>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok role="UNKNOWN">d</XMTok>
              <XMTok font="italic" role="UNKNOWN">t</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math></p>
  </para>
</document>

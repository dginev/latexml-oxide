<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p><Math mode="inline" tex="0=\mathrm{d}L+\tfrac{1}{2}[L,L]" text="0 = differential-d@(L) + (1 / 2) * closed-interval@(L, L)" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMTok meaning="0" role="NUMBER">0</XMTok>
            <XMApp>
              <XMTok meaning="plus" role="ADDOP">+</XMTok>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">L</XMTok>
              </XMApp>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMApp>
                  <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                  <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
                  <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
                </XMApp>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="closed-interval"/>
                    <XMRef idref="p1.m1.1"/>
                    <XMRef idref="p1.m1.2"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="false">[</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="p1.m1.1">L</XMTok>
                    <XMTok role="PUNCT">,</XMTok>
                    <XMTok font="italic" role="UNKNOWN" xml:id="p1.m1.2">L</XMTok>
                    <XMTok role="CLOSE" stretchy="false">]</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\rho_{t}\,\mathrm{d}t" text="rho _ t * differential-d@(t)" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok meaning="times" role="MULOP">⁢</XMTok>
            <XMApp rpadding="1.7pt">
              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
              <XMTok font="italic" name="rho" role="UNKNOWN">ρ</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
              <XMTok font="italic" role="UNKNOWN">t</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\int_{\Omega}f\,\mathrm{d}x" text="(integral _ Omega)@(f * differential-d@(x))" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
              <XMTok mathstyle="text" meaning="integral" name="int" role="INTOP">∫</XMTok>
              <XMTok fontsize="70%" name="Omega" role="UNKNOWN">Ω</XMTok>
            </XMApp>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN" rpadding="1.7pt">f</XMTok>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="x\in\mathbb{R}^{d}" text="x element-of R ^ d" xml:id="p1.m4">
        <XMath>
          <XMApp>
            <XMTok meaning="element-of" name="in" role="RELOP">∈</XMTok>
            <XMTok font="italic" role="UNKNOWN">x</XMTok>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
              <XMTok font="blackboard" role="UNKNOWN">R</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">d</XMTok>
            </XMApp>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\|u-u_{h}\|\leq Cdh^{3}" text="norm@(u - u _ h) &lt;= C * d * h ^ 3" xml:id="p1.m5">
        <XMath>
          <XMApp>
            <XMTok meaning="less-than-or-equals" name="leq" role="RELOP">≤</XMTok>
            <XMDual>
              <XMApp>
                <XMTok meaning="norm"/>
                <XMRef idref="p1.m5.1"/>
              </XMApp>
              <XMWrap>
                <XMTok name="||" role="OPEN">‖</XMTok>
                <XMApp xml:id="p1.m5.1">
                  <XMTok meaning="minus" role="ADDOP">-</XMTok>
                  <XMTok font="italic" role="UNKNOWN">u</XMTok>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">u</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">h</XMTok>
                  </XMApp>
                </XMApp>
                <XMTok name="||" role="CLOSE">‖</XMTok>
              </XMWrap>
            </XMDual>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMTok font="italic" role="UNKNOWN">C</XMTok>
              <XMTok font="italic" role="UNKNOWN">d</XMTok>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">h</XMTok>
                <XMTok fontsize="70%" meaning="3" role="NUMBER">3</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math></p>
  </para>
</document>

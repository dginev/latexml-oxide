<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <p><Math mode="inline" tex="\frac{1}{\mathrm{d}s/\mathrm{d}\lambda}" text="1 / differential-d@(s) / differential-d@(lambda)" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
            <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
            <XMApp>
              <XMTok fontsize="70%" meaning="divide" role="MULOP">/</XMTok>
              <XMApp>
                <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">s</XMTok>
              </XMApp>
              <XMApp>
                <XMTok fontsize="70%" meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" fontsize="70%" name="lambda" role="UNKNOWN">λ</XMTok>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="\hat{\mathrm{d}}g^{i}=\sum_{K}\frac{\partial g^{i}}{\partial u_{K}}\,\mathrm{d}u_{K}" text="hat@(d) * g ^ i = (sum _ K)@((partial-differential@(g ^ i) / partial-differential@(u _ K)) * differential-d@(u _ K))" xml:id="p1.m2">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok name="hat" role="OVERACCENT" stretchy="false">^</XMTok>
                <XMTok role="UNKNOWN">d</XMTok>
              </XMApp>
              <XMApp>
                <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                <XMTok font="italic" role="UNKNOWN">g</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
              </XMApp>
            </XMApp>
            <XMApp>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMTok mathstyle="text" meaning="sum" role="SUMOP" scriptpos="post">∑</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">K</XMTok>
              </XMApp>
              <XMApp>
                <XMTok meaning="times" role="MULOP">⁢</XMTok>
                <XMApp rpadding="1.7pt">
                  <XMTok mathstyle="text" meaning="divide" role="FRACOP"/>
                  <XMApp>
                    <XMTok fontsize="70%" meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                    <XMApp>
                      <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                      <XMTok font="italic" fontsize="70%" role="UNKNOWN">g</XMTok>
                      <XMTok font="italic" fontsize="50%" role="UNKNOWN">i</XMTok>
                    </XMApp>
                  </XMApp>
                  <XMApp>
                    <XMTok fontsize="70%" meaning="partial-differential" name="partial" role="DIFFOP">∂</XMTok>
                    <XMApp>
                      <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
                      <XMTok font="italic" fontsize="70%" role="UNKNOWN">u</XMTok>
                      <XMTok font="italic" fontsize="50%" role="UNKNOWN">K</XMTok>
                    </XMApp>
                  </XMApp>
                </XMApp>
                <XMApp>
                  <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">u</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">K</XMTok>
                  </XMApp>
                </XMApp>
              </XMApp>
            </XMApp>
          </XMApp>
        </XMath>
      </Math>
<Math mode="inline" tex="N^{\ast}_{V}C=\left&lt;\mathrm{d}g^{i}|i=1,\dots,m\right&gt;" text="(N ^ ast) _ V * C = inner-product@(differential-d@(g ^ i), i = list@(1, dots, m))" xml:id="p1.m3">
        <XMath>
          <XMApp>
            <XMTok meaning="equals" role="RELOP">=</XMTok>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">N</XMTok>
                  <XMTok fontsize="70%" name="ast" role="MULOP">∗</XMTok>
                </XMApp>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">V</XMTok>
              </XMApp>
              <XMTok font="italic" role="UNKNOWN">C</XMTok>
            </XMApp>
            <XMDual>
              <XMApp>
                <XMTok meaning="inner-product"/>
                <XMRef idref="p1.m3.1"/>
                <XMRef idref="p1.m3.2"/>
              </XMApp>
              <XMWrap>
                <XMTok name="langle" role="OPEN" stretchy="true">⟨</XMTok>
                <XMApp xml:id="p1.m3.1">
                  <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                  <XMApp>
                    <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                    <XMTok font="italic" role="UNKNOWN">g</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
                  </XMApp>
                </XMApp>
                <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                <XMApp xml:id="p1.m3.2">
                  <XMTok meaning="equals" role="RELOP">=</XMTok>
                  <XMTok font="italic" role="UNKNOWN">i</XMTok>
                  <XMDual>
                    <XMApp>
                      <XMTok meaning="list"/>
                      <XMRef idref="p1.m3.3"/>
                      <XMRef idref="p1.m3.4"/>
                      <XMRef idref="p1.m3.5"/>
                    </XMApp>
                    <XMWrap>
                      <XMTok meaning="1" role="NUMBER" xml:id="p1.m3.3">1</XMTok>
                      <XMTok role="PUNCT">,</XMTok>
                      <XMTok name="dots" role="ID" xml:id="p1.m3.4">…</XMTok>
                      <XMTok role="PUNCT">,</XMTok>
                      <XMTok font="italic" role="UNKNOWN" xml:id="p1.m3.5">m</XMTok>
                    </XMWrap>
                  </XMDual>
                </XMApp>
                <XMTok name="rangle" role="CLOSE" stretchy="true">⟩</XMTok>
              </XMWrap>
            </XMDual>
          </XMApp>
        </XMath>
      </Math></p>
  </para>
</document>

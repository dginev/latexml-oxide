        </Math></p>
    </para>
    <para xml:id="S3.p2">
      <p><Math mode="inline" tex="\begin{pmatrix}a\\&#10;b\end{pmatrix}(x+y)" text="matrix@(Array[[a], [b]]) * (x + y)" xml:id="S3.p2.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="matrix"/>
                  <XMRef idref="S3.p2.m1.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMArray xml:id="S3.p2.m1.1">
                    <XMRow>
                      <XMCell align="center">
                        <XMTok font="italic" role="UNKNOWN">a</XMTok>
                      </XMCell>

    <title><tag close=" ">3</tag>Divergence 18 applies letters, never a pre-built atom</title>
    <para xml:id="S3.p1">
      <p><Math mode="inline" tex="\binom{n}{2}(x+1)" text="binomial@(n, 2) * (x + 1)" xml:id="S3.p1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="binomial" name="binom" role="UNKNOWN"/>
                  <XMRef idref="S3.p1.m1.2"/>
                  <XMRef idref="S3.p1.m1.3"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="true">(</XMTok>
                  <XMApp xml:id="S3.p1.m1.1">
                    <XMTok mathstyle="text" role="FRACOP" thickness="0pt"/>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN" xml:id="S3.p1.m1.2">n</XMTok>
                    <XMTok fontsize="70%" meaning="2" role="NUMBER" xml:id="S3.p1.m1.3">2</XMTok>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="true">)</XMTok>
                </XMWrap>
              </XMDual>
              <XMDual>
                <XMRef idref="S3.p1.m1.4"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="S3.p1.m1.4">
                    <XMTok meaning="plus" role="ADDOP">+</XMTok>
                    <XMTok font="italic" role="UNKNOWN">x</XMTok>
                    <XMTok meaning="1" role="NUMBER">1</XMTok>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="c\cdot\binom{n}{k}(1-p)" text="(c cdot binomial@(n, k)) * (1 - p)" xml:id="S3.p1.m2">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok name="cdot" role="MULOP">⋅</XMTok>
                <XMTok font="italic" role="UNKNOWN">c</XMTok>
                <XMDual>
                  <XMApp>
                    <XMTok meaning="binomial" name="binom" role="UNKNOWN"/>
                    <XMRef idref="S3.p1.m2.2"/>
                    <XMRef idref="S3.p1.m2.3"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok role="OPEN" stretchy="true">(</XMTok>
                    <XMApp xml:id="S3.p1.m2.1">
                      <XMTok mathstyle="text" role="FRACOP" thickness="0pt"/>
                      <XMTok font="italic" fontsize="70%" role="UNKNOWN" xml:id="S3.p1.m2.2">n</XMTok>
                      <XMTok font="italic" fontsize="70%" role="UNKNOWN" xml:id="S3.p1.m2.3">k</XMTok>
                    </XMApp>
                    <XMTok role="CLOSE" stretchy="true">)</XMTok>
                  </XMWrap>
                </XMDual>
              </XMApp>
              <XMDual>
                <XMRef idref="S3.p1.m2.4"/>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMApp xml:id="S3.p1.m2.4">
                    <XMTok meaning="minus" role="ADDOP">-</XMTok>
                    <XMTok meaning="1" role="NUMBER">1</XMTok>
                    <XMTok font="italic" role="UNKNOWN">p</XMTok>
                  </XMApp>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math> <Math mode="inline" tex="a\cdot{n\choose k}(p)" text="(a cdot (n binomial k)) * p" xml:id="S3.p1.m3">
          <XMath>
            <XMApp>
              <XMTok meaning="times" role="MULOP">⁢</XMTok>
              <XMApp>
                <XMTok name="cdot" role="MULOP">⋅</XMTok>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMDual>
                  <XMApp>
                    <XMRef idref="S3.p1.m3.2"/>

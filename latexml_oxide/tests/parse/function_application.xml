    <title><tag close=" ">2</tag>The other pragmas still pass or fail whole</title>
    <para xml:id="S2.p1">
      <p><Math mode="inline" tex="\langle Uf|Ug\rangle=\langle f|g\rangle" text="inner-product@(U * f, U * g) = inner-product@(f, g)" xml:id="S2.p1.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="inner-product"/>
                  <XMRef idref="S2.p1.m1.1"/>
                  <XMRef idref="S2.p1.m1.2"/>
                </XMApp>
                <XMWrap>
                  <XMTok name="langle" role="OPEN" stretchy="false">⟨</XMTok>
                  <XMApp xml:id="S2.p1.m1.1">
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" role="UNKNOWN">U</XMTok>
                    <XMTok font="italic" role="UNKNOWN">f</XMTok>
                  </XMApp>
                  <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                  <XMApp xml:id="S2.p1.m1.2">
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" role="UNKNOWN">U</XMTok>
                    <XMTok font="italic" role="UNKNOWN">g</XMTok>
                  </XMApp>
                  <XMTok name="rangle" role="CLOSE" stretchy="false">⟩</XMTok>
                </XMWrap>
              </XMDual>
              <XMDual>
                <XMApp>
                  <XMTok meaning="inner-product"/>
                  <XMRef idref="S2.p1.m1.3"/>
                  <XMRef idref="S2.p1.m1.4"/>
                </XMApp>
                <XMWrap>
                  <XMTok name="langle" role="OPEN" stretchy="false">⟨</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m1.3">f</XMTok>
                  <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.p1.m1.4">g</XMTok>
                  <XMTok name="rangle" role="CLOSE" stretchy="false">⟩</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math></p>
    </para>
    <para xml:id="S2.p2">
      <p><Math mode="inline" tex="\langle x|y\rangle=\langle Tx|Ty\rangle" text="inner-product@(x, y) = inner-product@(T * x, T * y)" xml:id="S2.p2.m1">
          <XMath>
            <XMApp>
              <XMTok meaning="equals" role="RELOP">=</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="inner-product"/>
                  <XMRef idref="S2.p2.m1.1"/>
                  <XMRef idref="S2.p2.m1.2"/>
                </XMApp>
                <XMWrap>
                  <XMTok name="langle" role="OPEN" stretchy="false">⟨</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.p2.m1.1">x</XMTok>
                  <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.p2.m1.2">y</XMTok>
                  <XMTok name="rangle" role="CLOSE" stretchy="false">⟩</XMTok>
                </XMWrap>
              </XMDual>
              <XMDual>
                <XMApp>
                  <XMTok meaning="inner-product"/>
                  <XMRef idref="S2.p2.m1.3"/>
                  <XMRef idref="S2.p2.m1.4"/>
                </XMApp>
                <XMWrap>
                  <XMTok name="langle" role="OPEN" stretchy="false">⟨</XMTok>
                  <XMApp xml:id="S2.p2.m1.3">
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" role="UNKNOWN">T</XMTok>
                    <XMTok font="italic" role="UNKNOWN">x</XMTok>
                  </XMApp>
                  <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                  <XMApp xml:id="S2.p2.m1.4">
                    <XMTok meaning="times" role="MULOP">⁢</XMTok>
                    <XMTok font="italic" role="UNKNOWN">T</XMTok>
                    <XMTok font="italic" role="UNKNOWN">y</XMTok>
                  </XMApp>
                  <XMTok name="rangle" role="CLOSE" stretchy="false">⟩</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math></p>
    </para>

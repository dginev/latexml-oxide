        </XMath>
      </Math> <Math mode="inline" tex="\mathrm{d}X=\mu X\,\mathrm{d}t+\sigma X\,\mathrm{d}W" text="differential-d@(X) = mu * X * differential-d@(t) + sigma * X * differential-d@(W)" xml:id="p1.m2">

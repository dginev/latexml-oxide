            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
              <XMApp>
                <XMTok meaning="differential-d" role="DIFFOP">d</XMTok>
                <XMTok font="italic" role="UNKNOWN">s</XMTok>
              </XMApp>
              <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
            </XMApp>

  <para xml:id="p1">
    <p><Math mode="inline" tex="\mathrm{d}s^{2}\approx r^{2}\mathrm{d}\Omega^{2}+\underbrace{f\,\mathrm{d}r^{2}+g\,\mathrm{d}\theta^{2}}_{h_{\alpha\beta}\mathrm{d}y^{\alpha}\mathrm{d}y^{\beta}}" text="(differential-d@(s)) ^ 2 approximately-equals r ^ 2 * (differential-d@(Omega)) ^ 2 + (underbrace@(f * (differential-d@(r)) ^ 2 + g * (differential-d@(theta)) ^ 2)) _ (h _ (alpha * beta) * differential-d@(y ^ alpha) * differential-d@(y ^ beta))" xml:id="p1.m1">

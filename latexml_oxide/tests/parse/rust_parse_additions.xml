<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml package="amsmath,amssymb"?>
<?latexml package="latexml"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <section inlist="toc" xml:id="S1">
    <tags>
      <tag>1</tag>
      <tag role="refnum">1</tag>
      <tag role="typerefnum">§1</tag>
    </tags>
    <title><tag close=" ">1</tag>Multi-argument calls flatten</title>
    <para xml:id="S1.p1">
      <equation xml:id="S1.Ex1">
        <Math mode="display" tex="f(a,b)" text="f@(a, b)" xml:id="S1.Ex1.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMRef idref="S1.Ex1.m1.1"/>
                <XMRef idref="S1.Ex1.m1.2"/>
                <XMRef idref="S1.Ex1.m1.3"/>
              </XMApp>
              <XMApp>
                <XMTok font="italic" role="FUNCTION" xml:id="S1.Ex1.m1.1">f</XMTok>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex1.m1.2">a</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex1.m1.3">b</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMApp>
            </XMDual>
          </XMath>
        </Math>
      </equation>
      <equation xml:id="S1.Ex2">
        <Math mode="display" tex="g(a,b,c)" text="g@(a, b, c)" xml:id="S1.Ex2.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMRef idref="S1.Ex2.m1.1"/>
                <XMRef idref="S1.Ex2.m1.2"/>
                <XMRef idref="S1.Ex2.m1.3"/>
                <XMRef idref="S1.Ex2.m1.4"/>
              </XMApp>
              <XMApp>
                <XMTok font="italic" role="FUNCTION" xml:id="S1.Ex2.m1.1">g</XMTok>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex2.m1.2">a</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex2.m1.3">b</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex2.m1.4">c</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMApp>
            </XMDual>
          </XMath>
        </Math>
      </equation>
      <equation xml:id="S1.Ex3">
        <Math mode="display" tex="\max(a,b)" text="maximum@(a, b)" xml:id="S1.Ex3.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMRef idref="S1.Ex3.m1.1"/>
                <XMRef idref="S1.Ex3.m1.2"/>
                <XMRef idref="S1.Ex3.m1.3"/>
              </XMApp>
              <XMApp>
                <XMTok meaning="maximum" role="OPFUNCTION" scriptpos="mid" xml:id="S1.Ex3.m1.1">max</XMTok>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">(</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex3.m1.2">a</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S1.Ex3.m1.3">b</XMTok>
                  <XMTok role="CLOSE" stretchy="false">)</XMTok>
                </XMWrap>
              </XMApp>
            </XMDual>
          </XMath>
        </Math>
      </equation>
    </para>
  </section>
  <section inlist="toc" xml:id="S2">
    <tags>
      <tag>2</tag>
      <tag role="refnum">2</tag>
      <tag role="typerefnum">§2</tag>
    </tags>
    <title><tag close=" ">2</tag>Comma-list left of a relation (distributed XMDual)</title>
    <para xml:id="S2.p1">
      <equation xml:id="S2.Ex4">
        <Math mode="display" tex="a,b\in A" text="formulae@(a element-of A, b element-of A)" xml:id="S2.Ex4.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="formulae"/>
                <XMApp>
                  <XMRef idref="S2.Ex4.m1.1"/>
                  <XMRef idref="S2.Ex4.m1.2"/>
                  <XMRef idref="S2.Ex4.m1.4"/>
                </XMApp>
                <XMApp>
                  <XMRef idref="S2.Ex4.m1.1"/>
                  <XMRef idref="S2.Ex4.m1.3"/>
                  <XMRef idref="S2.Ex4.m1.4"/>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="element-of" name="in" role="RELOP" xml:id="S2.Ex4.m1.1">∈</XMTok>
                <XMWrap>
                  <XMTok font="italic" role="ID" xml:id="S2.Ex4.m1.2">a</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="ID" xml:id="S2.Ex4.m1.3">b</XMTok>
                </XMWrap>
                <XMTok font="italic" role="UNKNOWN" xml:id="S2.Ex4.m1.4">A</XMTok>
              </XMApp>
            </XMDual>
          </XMath>
        </Math>
      </equation>
      <equation xml:id="S2.Ex5">
        <Math mode="display" tex="x,y\leq z" text="formulae@(x &lt;= z, y &lt;= z)" xml:id="S2.Ex5.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="formulae"/>
                <XMApp>
                  <XMRef idref="S2.Ex5.m1.1"/>
                  <XMRef idref="S2.Ex5.m1.2"/>
                  <XMRef idref="S2.Ex5.m1.4"/>
                </XMApp>
                <XMApp>
                  <XMRef idref="S2.Ex5.m1.1"/>
                  <XMRef idref="S2.Ex5.m1.3"/>
                  <XMRef idref="S2.Ex5.m1.4"/>
                </XMApp>
              </XMApp>
              <XMApp>
                <XMTok meaning="less-than-or-equals" name="leq" role="RELOP" xml:id="S2.Ex5.m1.1">≤</XMTok>
                <XMWrap>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.Ex5.m1.2">x</XMTok>
                  <XMTok role="PUNCT">,</XMTok>
                  <XMTok font="italic" role="UNKNOWN" xml:id="S2.Ex5.m1.3">y</XMTok>
                </XMWrap>
                <XMTok font="italic" role="UNKNOWN" xml:id="S2.Ex5.m1.4">z</XMTok>
              </XMApp>
            </XMDual>
          </XMath>
        </Math>
      </equation>
    </para>
  </section>
  <section inlist="toc" xml:id="S3">
    <tags>
      <tag>3</tag>
      <tag role="refnum">3</tag>
      <tag role="typerefnum">§3</tag>
    </tags>
    <title><tag close=" ">3</tag>A set-builder bar may be written mid</title>
    <para xml:id="S3.p1">
      <equation xml:id="S3.Ex6">
        <Math mode="display" tex="\{a\mid a\in b\}" text="conditional-set@(a, a element-of b)" xml:id="S3.Ex6.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="conditional-set"/>
                <XMRef idref="S3.Ex6.m1.1"/>
                <XMRef idref="S3.Ex6.m1.2"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">{</XMTok>
                <XMTok font="italic" role="ID" xml:id="S3.Ex6.m1.1">a</XMTok>
                <XMTok name="mid" role="MIDDLE">∣</XMTok>
                <XMApp xml:id="S3.Ex6.m1.2">
                  <XMTok meaning="element-of" name="in" role="RELOP">∈</XMTok>
                  <XMTok font="italic" role="ID">a</XMTok>
                  <XMTok font="italic" role="ID">b</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">}</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math>
      </equation>
    </para>
  </section>
  <section inlist="toc" xml:id="S4">
    <tags>
      <tag>4</tag>
      <tag role="refnum">4</tag>
      <tag role="typerefnum">§4</tag>
    </tags>
    <title><tag close=" ">4</tag>Bracketed conditional</title>
    <para xml:id="S4.p1">
      <equation xml:id="S4.Ex7">
        <Math mode="display" tex="[a|b]" text="delimited-[]@(conditional@(a, b))" xml:id="S4.Ex7.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="delimited-[]"/>
                <XMRef idref="S4.Ex7.m1.1"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">[</XMTok>
                <XMDual xml:id="S4.Ex7.m1.1">
                  <XMApp>
                    <XMTok meaning="conditional"/>
                    <XMRef idref="S4.Ex7.m1.2"/>
                    <XMRef idref="S4.Ex7.m1.3"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok font="italic" role="ID" xml:id="S4.Ex7.m1.2">a</XMTok>
                    <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                    <XMTok font="italic" role="ID" xml:id="S4.Ex7.m1.3">b</XMTok>
                  </XMWrap>
                </XMDual>
                <XMTok role="CLOSE" stretchy="false">]</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math>
      </equation>
      <equation xml:id="S4.Ex8">
        <Math mode="display" tex="[a\mid b]" text="delimited-[]@(conditional@(a, b))" xml:id="S4.Ex8.m1">
          <XMath>
            <XMDual>
              <XMApp>
                <XMTok meaning="delimited-[]"/>
                <XMRef idref="S4.Ex8.m1.1"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">[</XMTok>
                <XMDual xml:id="S4.Ex8.m1.1">
                  <XMApp>
                    <XMTok meaning="conditional"/>
                    <XMRef idref="S4.Ex8.m1.2"/>
                    <XMRef idref="S4.Ex8.m1.3"/>
                  </XMApp>
                  <XMWrap>
                    <XMTok font="italic" role="ID" xml:id="S4.Ex8.m1.2">a</XMTok>
                    <XMTok name="mid" role="VERTBAR">∣</XMTok>
                    <XMTok font="italic" role="ID" xml:id="S4.Ex8.m1.3">b</XMTok>
                  </XMWrap>
                </XMDual>
                <XMTok role="CLOSE" stretchy="false">]</XMTok>
              </XMWrap>
            </XMDual>
          </XMath>
        </Math>
      </equation>
      <equation xml:id="S4.Ex9">
        <Math mode="display" tex="E[X|Y]" text="E@(delimited-[]@(conditional@(X, Y)))" xml:id="S4.Ex9.m1">
          <XMath>
            <XMApp>
              <XMTok font="italic" role="UNKNOWN">E</XMTok>
              <XMDual>
                <XMApp>
                  <XMTok meaning="delimited-[]"/>
                  <XMRef idref="S4.Ex9.m1.1"/>
                </XMApp>
                <XMWrap>
                  <XMTok role="OPEN" stretchy="false">[</XMTok>
                  <XMDual xml:id="S4.Ex9.m1.1">
                    <XMApp>
                      <XMTok meaning="conditional"/>
                      <XMRef idref="S4.Ex9.m1.2"/>
                      <XMRef idref="S4.Ex9.m1.3"/>
                    </XMApp>
                    <XMWrap>
                      <XMTok font="italic" role="UNKNOWN" xml:id="S4.Ex9.m1.2">X</XMTok>
                      <XMTok role="VERTBAR" stretchy="false">|</XMTok>
                      <XMTok font="italic" role="UNKNOWN" xml:id="S4.Ex9.m1.3">Y</XMTok>
                    </XMWrap>
                  </XMDual>
                  <XMTok role="CLOSE" stretchy="false">]</XMTok>
                </XMWrap>
              </XMDual>
            </XMApp>
          </XMath>
        </Math>
      </equation>
    </para>
  </section>
</document>

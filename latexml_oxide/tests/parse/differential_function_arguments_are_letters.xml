  <para xml:id="p1">
    <p><Math mode="inline" tex="O(n\log(dn))" text="O@(n * logarithm@(d * n))" xml:id="p1.m1">
        <XMath>
          <XMApp>
            <XMTok font="italic" role="UNKNOWN">O</XMTok>
            <XMDual>
              <XMRef idref="p1.m1.1"/>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m1.1">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">n</XMTok>
                  <XMDual>
                    <XMApp>
                      <XMRef idref="p1.m1.2"/>
                      <XMRef idref="p1.m1.3"/>
                    </XMApp>
                    <XMApp>
                      <XMTok meaning="logarithm" role="OPFUNCTION" xml:id="p1.m1.2">log</XMTok>
                      <XMWrap>
                        <XMTok role="OPEN" stretchy="false">(</XMTok>
                        <XMApp xml:id="p1.m1.3">
                          <XMTok meaning="times" role="MULOP">⁢</XMTok>
                          <XMTok font="italic" role="UNKNOWN">d</XMTok>
                          <XMTok font="italic" role="UNKNOWN">n</XMTok>
                        </XMApp>
                        <XMTok role="CLOSE" stretchy="false">)</XMTok>
                      </XMWrap>
                    </XMApp>
                  </XMDual>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMDual>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\max(dk,n)" text="maximum@(d * k, n)" xml:id="p1.m2">
        <XMath>
          <XMDual>
            <XMApp>
              <XMRef idref="p1.m2.1"/>
              <XMRef idref="p1.m2.2"/>
              <XMRef idref="p1.m2.3"/>
            </XMApp>
            <XMApp>
              <XMTok meaning="maximum" role="OPFUNCTION" scriptpos="post" xml:id="p1.m2.1">max</XMTok>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m2.2">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">k</XMTok>
                </XMApp>
                <XMTok role="PUNCT">,</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="p1.m2.3">n</XMTok>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMApp>
          </XMDual>
        </XMath>
      </Math> <Math mode="inline" tex="\min(dn,m)" text="minimum@(d * n, m)" xml:id="p1.m3">
        <XMath>
          <XMDual>
            <XMApp>
              <XMRef idref="p1.m3.1"/>
              <XMRef idref="p1.m3.2"/>
              <XMRef idref="p1.m3.3"/>
            </XMApp>
            <XMApp>
              <XMTok meaning="minimum" role="OPFUNCTION" scriptpos="post" xml:id="p1.m3.1">min</XMTok>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m3.2">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">n</XMTok>
                </XMApp>
                <XMTok role="PUNCT">,</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="p1.m3.3">m</XMTok>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMApp>
          </XMDual>
        </XMath>
      </Math> <Math mode="inline" tex="\exp(dt)" text="exponential@(d * t)" xml:id="p1.m4">
        <XMath>
          <XMDual>
            <XMApp>
              <XMRef idref="p1.m4.1"/>
              <XMRef idref="p1.m4.2"/>
            </XMApp>
            <XMApp>
              <XMTok meaning="exponential" role="OPFUNCTION" xml:id="p1.m4.1">exp</XMTok>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m4.2">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">t</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMApp>
          </XMDual>
        </XMath>
      </Math> <Math mode="inline" tex="\log(dk)" text="logarithm@(d * k)" xml:id="p1.m5">
        <XMath>
          <XMDual>
            <XMApp>
              <XMRef idref="p1.m5.1"/>
              <XMRef idref="p1.m5.2"/>
            </XMApp>
            <XMApp>
              <XMTok meaning="logarithm" role="OPFUNCTION" xml:id="p1.m5.1">log</XMTok>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m5.2">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">k</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMApp>
          </XMDual>
        </XMath>
      </Math> <Math mode="inline" tex="\sup(dx)" text="supremum@(d * x)" xml:id="p1.m6">
        <XMath>
          <XMApp>
            <XMTok meaning="supremum" role="LIMITOP" scriptpos="post">sup</XMTok>
            <XMDual>
              <XMRef idref="p1.m6.1"/>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m6.1">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">x</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMDual>
          </XMApp>
        </XMath>
      </Math> <Math mode="inline" tex="\gcd(dn,m)" text="gcd@(d * n, m)" xml:id="p1.m7">
        <XMath>
          <XMDual>
            <XMApp>
              <XMRef idref="p1.m7.1"/>
              <XMRef idref="p1.m7.2"/>
              <XMRef idref="p1.m7.3"/>
            </XMApp>
            <XMApp>
              <XMTok meaning="gcd" role="OPFUNCTION" scriptpos="post" xml:id="p1.m7.1">gcd</XMTok>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">(</XMTok>
                <XMApp xml:id="p1.m7.2">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">n</XMTok>
                </XMApp>
                <XMTok role="PUNCT">,</XMTok>
                <XMTok font="italic" role="UNKNOWN" xml:id="p1.m7.3">m</XMTok>
                <XMTok role="CLOSE" stretchy="false">)</XMTok>
              </XMWrap>
            </XMApp>
          </XMDual>
        </XMath>
      </Math> <Math mode="inline" tex="\mathbb{E}\{dX_{t}\}" text="E@(d * X _ t)" xml:id="p1.m8">
        <XMath>
          <XMDual>
            <XMApp>
              <XMRef idref="p1.m8.1"/>
              <XMRef idref="p1.m8.2"/>
            </XMApp>
            <XMApp>
              <XMTok font="blackboard" role="UNKNOWN" xml:id="p1.m8.1">E</XMTok>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">{</XMTok>
                <XMApp xml:id="p1.m8.2">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMApp>
                    <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                    <XMTok font="italic" role="UNKNOWN">X</XMTok>
                    <XMTok font="italic" fontsize="70%" role="UNKNOWN">t</XMTok>
                  </XMApp>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">}</XMTok>
              </XMWrap>
            </XMApp>
          </XMDual>
        </XMath>
      </Math> <Math mode="inline" tex="f\{dn\}" text="f * set@(d * n)" xml:id="p1.m9">
        <XMath>
          <XMApp>
            <XMTok meaning="times" role="MULOP">⁢</XMTok>
            <XMTok font="italic" role="UNKNOWN">f</XMTok>
            <XMDual>
              <XMApp>
                <XMTok meaning="set"/>
                <XMRef idref="p1.m9.1"/>
              </XMApp>
              <XMWrap>
                <XMTok role="OPEN" stretchy="false">{</XMTok>
                <XMApp xml:id="p1.m9.1">
                  <XMTok meaning="times" role="MULOP">⁢</XMTok>
                  <XMTok font="italic" role="UNKNOWN">d</XMTok>
                  <XMTok font="italic" role="UNKNOWN">n</XMTok>
                </XMApp>
                <XMTok role="CLOSE" stretchy="false">}</XMTok>
              </XMWrap>
            </XMDual>
          </XMApp>
        </XMath>
      </Math></p>
  </para>

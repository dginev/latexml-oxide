<?xml version="1.0" encoding="UTF-8"?>

<?latexml class="article"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML" xmlns:m="http://www.w3.org/1998/Math/MathML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="{x_{a}}^{b}" text="(x _ a) ^ b" xml:id="S0.Ex1.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="post2"/>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">a</XMTok>
            </XMApp>
            <XMTok font="italic" fontsize="70%" role="UNKNOWN">b</XMTok>
          </XMApp>
        </XMath>
        <m:math alttext="{x_{a}}^{b}" display="block"><m:mmultiscripts><m:mi>x</m:mi><m:mi>a</m:mi><m:mrow/><m:mrow/><m:mi>b</m:mi></m:mmultiscripts></m:math></Math>
    </equation>
    <equation xml:id="S0.Ex2">
      <Math mode="display" tex="{x^{a}}_{b}" text="(x ^ a) _ b" xml:id="S0.Ex2.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
              <XMTok font="italic" role="UNKNOWN">x</XMTok>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">a</XMTok>
            </XMApp>
            <XMTok font="italic" fontsize="70%" role="UNKNOWN">b</XMTok>
          </XMApp>
        </XMath>
        <m:math alttext="{x^{a}}_{b}" display="block"><m:mmultiscripts><m:mi>x</m:mi><m:mrow/><m:mi>a</m:mi><m:mi>b</m:mi><m:mrow/></m:mmultiscripts></m:math></Math>
    </equation>
    <equation xml:id="S0.Ex3">
      <Math mode="display" tex="{}^{1}_{2}X^{3}_{4}" text="^ 1 _ 2 (X ^ 3) _ 4" xml:id="S0.Ex3.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUPERSCRIPTOP" scriptpos="pre1"/>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="pre1"/>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
                <XMApp>
                  <XMTok role="SUPERSCRIPTOP" scriptpos="post1"/>
                  <XMTok font="italic" role="UNKNOWN">X</XMTok>
                  <XMTok fontsize="70%" meaning="3" role="NUMBER">3</XMTok>
                </XMApp>
                <XMTok fontsize="70%" meaning="4" role="NUMBER">4</XMTok>
              </XMApp>
              <XMTok fontsize="70%" meaning="2" role="NUMBER">2</XMTok>
            </XMApp>
            <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
          </XMApp>
        </XMath>
        <m:math alttext="{}^{1}_{2}X^{3}_{4}" display="block"><m:mmultiscripts><m:mi>X</m:mi><m:mn>4</m:mn><m:mn>3</m:mn><m:mprescripts/><m:mn>2</m:mn><m:mn>1</m:mn></m:mmultiscripts></m:math></Math>
    </equation>
    <equation xml:id="S0.Ex4">
      <Math mode="display" tex="{{x_{a}}^{b}}_{c}" text="((x _ a) ^ b) _ c" xml:id="S0.Ex4.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUBSCRIPTOP" scriptpos="post1"/>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
              <XMApp>
                <XMTok role="SUBSCRIPTOP" scriptpos="post3"/>
                <XMTok font="italic" role="UNKNOWN">x</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">a</XMTok>
              </XMApp>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">b</XMTok>
            </XMApp>
            <XMTok font="italic" fontsize="70%" role="UNKNOWN">c</XMTok>
          </XMApp>
        </XMath>
        <m:math alttext="{{x_{a}}^{b}}_{c}" display="block"><m:mmultiscripts><m:mi>x</m:mi><m:mi>a</m:mi><m:mrow/><m:mrow/><m:mi>b</m:mi><m:mi>c</m:mi><m:mrow/></m:mmultiscripts></m:math></Math>
    </equation>
  </para>
</document>

<?xml version="1.0" encoding="UTF-8"?>
<?latexml class="article"?>
<?latexml RelaxNGSchema="LaTeXML"?>
<document xmlns="http://dlmf.nist.gov/LaTeXML">
  <resource src="LaTeXML.css" type="text/css"/>
  <resource src="ltx-article.css" type="text/css"/>
  <para xml:id="p1">
    <equation xml:id="S0.Ex1">
      <Math mode="display" tex="\mathop{X^{\prime}}\limits_{p}^{q}" text="((X ^ prime) _ p) ^ q" xml:id="S0.Ex1.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUPERSCRIPTOP" scriptpos="mid1"/>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="mid1"/>
              <XMApp role="BIGOP" scriptpos="mid1">
                <XMTok role="SUPERSCRIPTOP" scriptpos="post2"/>
                <XMTok font="italic" role="UNKNOWN">X</XMTok>
                <XMTok fontsize="70%" name="prime" role="SUPOP">′</XMTok>
              </XMApp>
              <XMTok font="italic" fontsize="70%" role="UNKNOWN">p</XMTok>
            </XMApp>
            <XMTok font="italic" fontsize="70%" role="UNKNOWN">q</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
  </para>
  <para xml:id="p2">
    <equation xml:id="S0.Ex2">
      <Math mode="display" tex="\mathop{\sum^{\prime}}\limits_{i=1}^{n}" text="((sum ^ prime) _ (i = 1)) ^ n" xml:id="S0.Ex2.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUPERSCRIPTOP" scriptpos="mid1"/>
            <XMApp>
              <XMTok role="SUBSCRIPTOP" scriptpos="mid1"/>
              <XMApp role="BIGOP" scriptpos="mid1">
                <XMTok role="SUPERSCRIPTOP" scriptpos="mid2"/>
                <XMTok mathstyle="display" meaning="sum" role="SUMOP" scriptpos="mid">∑</XMTok>
                <XMTok fontsize="70%" name="prime" role="SUPOP">′</XMTok>
              </XMApp>
              <XMApp>
                <XMTok fontsize="70%" meaning="equals" role="RELOP">=</XMTok>
                <XMTok font="italic" fontsize="70%" role="UNKNOWN">i</XMTok>
                <XMTok fontsize="70%" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMApp>
            <XMTok font="italic" fontsize="70%" role="UNKNOWN">n</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
  </para>
  <para xml:id="p3">
    <equation xml:id="S0.Ex3">
      <Math mode="display" tex="{\sum}^{\prime}\limits_{k}" text="(sum ^ prime) _ k" xml:id="S0.Ex3.m1">
        <XMath>
          <XMApp>
            <XMTok role="SUBSCRIPTOP" scriptpos="mid1"/>
            <XMApp>
              <XMTok role="SUPERSCRIPTOP" scriptpos="mid1"/>
              <XMTok mathstyle="display" meaning="sum" role="SUMOP" scriptpos="mid">∑</XMTok>
              <XMTok fontsize="70%" name="prime" role="SUPOP">′</XMTok>
            </XMApp>
            <XMTok font="italic" fontsize="70%" role="UNKNOWN">k</XMTok>
          </XMApp>
        </XMath>
      </Math>
    </equation>
  </para>
</document>

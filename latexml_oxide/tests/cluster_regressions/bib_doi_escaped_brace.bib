% A `doi` is an identifier, not TeX: its escapes and grouping braces are not part of it. MathSciNet writes the `_`
% of a DOI as `\{_}` (its `url` beside it reads `…3_10`); BibTeX counts the escaped brace, so the field is balanced
% for BibTeX, but a TeX reader taking `\{` for a control symbol met a stray `}` (2601.01900, 2511.01040, 2601.01772).
% `{\_}` and `\_` are the other spellings of the same underscore. `survivor` is the containment canary.
@incollection{mathscinet, AUTHOR = {Cordero, Dario}, TITLE = {Hypercontractive measures},
  BOOKTITLE = {GAFA}, YEAR = {2012}, DOI = {10.1007/978-3-642-29849-3\{_}10},
  URL = {https://doi.org/10.1007/978-3-642-29849-3_10}}
@article{bracedescape, AUTHOR = {Ito, Kei}, TITLE = {Braced escape}, JOURNAL = {J. Ids}, YEAR = {2020},
  DOI = {10.1000/a{\_}b}}
@article{plainescape, AUTHOR = {Oduya, Ama}, TITLE = {Plain escape}, JOURNAL = {J. Ids}, YEAR = {2021},
  DOI = {10.1000/c\_d}}
@article{survivor, AUTHOR = {Last, Lena}, TITLE = {The entry after the identifiers}, JOURNAL = {J. Ids},
  YEAR = {2022}}

  <float class="ltx_algorithm" framed="top" xml:id="algorithm1">
    <tags>
      <tag><text font="bold">Algorithm 1</text></tag>
      <tag role="refnum">1</tag>
    </tags>
    <toccaption><tag close=" ">1</tag>line numbering with a side comment</toccaption>
    <caption><tag close=" "><text font="bold">Algorithm 1</text></tag>line numbering with a side comment</caption>
    <listing class="ltx_lst_numbers_left" framed="topbottom">
      <listingline><text font="bold">Input :</text> a value</listingline>
      <listingline><text font="bold">Output :</text> a result</listingline>
      <listingline><text font="typewriter">/* </text><text font="typewriter">a standalone comment, unnumbered  */</text></listingline>
      <listingline><tags>
          <tag><text font="bold">1</text></tag>
        </tags><Math mode="inline" tex="a\leftarrow 1" text="a leftarrow 1" xml:id="algorithm1.m1">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMTok meaning="1" role="NUMBER">1</XMTok>
            </XMApp>
          </XMath>
        </Math>   <text font="typewriter">/* </text><text font="typewriter">a side comment; the statement stays numbered */</text></listingline>
      <listingline><tags>
          <tag><text font="bold">2</text></tag>
        </tags><text font="bold">for</text> <emph font="italic"><Math mode="inline" tex="i\leftarrow 1" text="i leftarrow 1" xml:id="algorithm1.m2">
            <XMath>
              <XMApp>
                <XMTok font="upright" name="leftarrow" role="ARROW">←</XMTok>
                <XMTok role="UNKNOWN">i</XMTok>
                <XMTok font="upright" meaning="1" role="NUMBER">1</XMTok>
              </XMApp>
            </XMath>
          </Math> <text font="bold upright">to</text> <Math mode="inline" tex="n" text="n" xml:id="algorithm1.m3">
            <XMath>
              <XMTok role="UNKNOWN">n</XMTok>
            </XMath>
          </Math></emph> <text font="bold">do</text></listingline>
      <listingline> <rule height="100%" width="1px"/> <tags>
          <tag><text font="bold">3</text></tag>
        </tags><Math mode="inline" tex="a\leftarrow a+i" text="a leftarrow a + i" xml:id="algorithm1.m4">
          <XMath>
            <XMApp>
              <XMTok name="leftarrow" role="ARROW">←</XMTok>
              <XMTok font="italic" role="UNKNOWN">a</XMTok>
              <XMApp>
                <XMTok meaning="plus" role="ADDOP">+</XMTok>
                <XMTok font="italic" role="UNKNOWN">a</XMTok>
                <XMTok font="italic" role="UNKNOWN">i</XMTok>
              </XMApp>
            </XMApp>
          </XMath>
        </Math></listingline>
      <listingline><tags>
          <tag><text font="bold">4</text></tag>
        </tags><text font="bold">return</text> <Math mode="inline" tex="a" text="a" xml:id="algorithm1.m5">
          <XMath>
            <XMTok font="italic" role="UNKNOWN">a</XMTok>
          </XMath>
        </Math></listingline>
      <listingline/>
